---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
  title?: string;
  /** Drops the column and chrome, for pages that own the whole viewport. */
  full?: boolean;
}

const { title = "BunnyMat's Portfolio | UI/UX Design & AI Projects ", full = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href="https://portfolio.bunnyy.workers.dev/home">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content="Matin's personal portfolio featuring aerospace interests, projects, articles, and things he builds while exploring technology and learning.">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class:list={[!full && "max-w-xl mx-auto px-4 md:px-0", "bg-neutral-50"]}>
    {!full && <Header />}
    <slot />
  </body>
</html>
